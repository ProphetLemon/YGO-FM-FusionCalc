<div class="max-w-[1380px] mx-auto px-6 pt-5 pb-10">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 mb-4">
        <h1 class="m-0 text-[26px] min-[701px]:text-[32px] leading-[1.1]"><%= t('deck.title') %></h1>
        <p class="m-0 max-w-[60ch] text-wb-subtle"><%= t('deck.subtitle') %></p>
    </div>

    <div class="grid grid-cols-1 gap-5 items-start min-[1101px]:grid-cols-[440px_minmax(0,1fr)]">
        <div class="flex flex-col gap-5 min-w-0">
            <section aria-labelledby="deck-file-title" class="win">
                <div class="win-bar win-bar-grey">
                    <h2 id="deck-file-title" class="win-title"><%= t('deck.file.title') %></h2>
                </div>
                <div class="win-body">
                    <label for="deck-file" class="block mb-2 font-bold"><%= t('deck.file.label') %></label>
                    <input
                        type="file"
                        id="deck-file"
                        aria-describedby="deck-file-hint"
                        class="wb-input w-full !h-auto py-1.5 cursor-pointer file:mr-3 file:px-3 file:py-1.5 file:font-bold file:bg-wb-plate file:border-2 file:border-solid file:border-wb-lo"
                    />
                    <p id="deck-file-hint" class="m-0 mt-3 text-sm text-wb-mute"><%= t('deck.file.hint') %></p>
                    <div id="deck-file-msg" class="empty:hidden mt-3"></div>
                    <fieldset id="deck-chooser" hidden class="m-0 mt-4 p-0 border-0 min-w-0">
                        <legend id="deck-chooser-legend" class="mb-2 p-0 font-bold"></legend>
                        <div id="deck-chooser-options" class="flex flex-col gap-2"></div>
                    </fieldset>
                </div>
            </section>

            <section id="deck-collection" hidden aria-labelledby="deck-collection-title" class="win">
                <div class="win-bar win-bar-blue">
                    <h2 id="deck-collection-title" class="win-title"><%= t('deck.collection.title') %></h2>
                </div>
                <div class="win-body">
                    <dl class="sink m-0 mb-4 p-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1">
                        <dt><%= t('deck.collection.deck') %></dt>
                        <dd id="deck-count" class="m-0 font-bold tabular-nums"></dd>
                        <dt><%= t('deck.collection.spare') %></dt>
                        <dd id="spare-count" class="m-0 font-bold tabular-nums"></dd>
                        <dt><%= t('deck.collection.kinds') %></dt>
                        <dd id="spare-kinds" class="m-0 font-bold tabular-nums"></dd>
                    </dl>
                    <p id="deck-no-spare" hidden class="m-0 mb-4 text-sm font-bold"><%= t('deck.collection.no-spare') %></p>
                    <div id="deck-locks" class="mb-4">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-3 mb-1">
                            <h3 class="m-0 text-base font-bold"><%= t('deck.lock.title') %></h3>
                            <p id="lock-count" aria-live="polite" class="m-0 text-sm font-bold tabular-nums"></p>
                        </div>
                        <p id="lock-hint" class="m-0 mb-3 text-sm text-wb-mute"><%= t('deck.lock.hint') %></p>
                        <div id="deck-lock-grid" aria-describedby="lock-hint"></div>
                        <div id="deck-added" hidden class="mt-4">
                            <h4 id="deck-added-title" class="m-0 mb-1 text-base font-bold"><%= t('deck.added.title') %></h4>
                            <p id="deck-added-hint" class="m-0 mb-3 text-sm text-wb-mute"><%= t('deck.added.hint') %></p>
                            <ul id="deck-added-list" aria-labelledby="deck-added-title" aria-describedby="deck-added-hint" class="m-0 p-0 list-none grid grid-cols-[repeat(auto-fill,minmax(88px,1fr))] gap-x-2.5 gap-y-3 justify-items-center"></ul>
                        </div>
                    </div>
                    <details id="deck-trunk" class="mb-4">
                        <summary id="deck-trunk-summary" class="min-h-11 py-2 font-bold cursor-pointer"></summary>
                        <!-- Outside the scroll box below, so the suggestions of the field are not clipped by it. -->
                        <div id="deck-manual" class="mb-3">
                            <label for="deck-manual-input" class="block mb-1 font-bold"><%= t('deck.manual.label') %></label>
                            <div class="flex items-start gap-2">
                                <!-- Own block wrapper: the autocomplete list is absolute with no top, so its parent must not be flex. -->
                                <div class="min-w-0 flex-1 basis-48">
                                    <input type="text" id="deck-manual-input" aria-describedby="deck-manual-msg" class="wb-input w-full" />
                                </div>
                                <button type="button" id="deck-manual-add" class="wb-btn"><%= t('deck.manual.add') %></button>
                            </div>
                            <p id="deck-manual-msg" role="status" aria-live="polite" class="empty:hidden m-0 mt-2 text-sm font-bold"></p>
                        </div>
                        <div id="deck-trunk-box" class="sink max-h-80 overflow-y-auto" tabindex="0" role="region" aria-labelledby="deck-trunk-summary">
                            <ul id="deck-trunk-list" class="m-0 p-0 list-none"></ul>
                        </div>
                    </details>
                    <button type="button" id="deck-compute" class="wb-btn aria-disabled:bg-wb-disabled aria-disabled:text-wb-disabled-text aria-disabled:cursor-wait">
                        <%= t('deck.btn.compute') %>
                    </button>
                    <div id="deck-compute-msg" class="empty:hidden mt-4"></div>
                </div>
            </section>
        </div>

        <div class="min-w-0">
            <div id="deck-status" role="status" aria-live="polite" class="sr-only"></div>
            <section id="deck-results-hint" aria-labelledby="deck-hint-title" class="win">
                <div class="win-bar win-bar-grey">
                    <h2 id="deck-hint-title" class="win-title"><%= t('deck.results.title') %></h2>
                </div>
                <div class="win-body">
                    <p class="m-0 max-w-[60ch]"><%= t('deck.results.hint') %></p>
                </div>
            </section>
            <section id="deck-loading" hidden aria-labelledby="deck-loading-title" class="win">
                <div class="win-bar win-bar-grey">
                    <h2 id="deck-loading-title" class="win-title"><%= t('deck.results.title') %></h2>
                </div>
                <div class="win-body">
                    <p class="m-0 mb-3"><%= t('deck.results.loading') %></p>
                    <div class="sink h-3" aria-hidden="true"><div class="h-full w-1/3 bg-wb-blue animate-pulse motion-reduce:animate-none"></div></div>
                </div>
            </section>
            <div id="deck-results" hidden></div>
        </div>
    </div>
</div>
