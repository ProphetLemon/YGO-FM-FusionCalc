<div class="max-w-[1380px] mx-auto px-6 pt-5 pb-10">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 mb-4">
        <h1 class="m-0 text-[26px] min-[701px]:text-[32px] leading-[1.1]"><%= t('home.hero.title') %></h1>
    </div>

    <section class="win mb-5">
        <div class="win-bar win-bar-grey">
            <h2 class="win-title"><%= t('home.hero.subtitle') %></h2>
        </div>
        <div class="win-body grid sm:grid-cols-[minmax(0,1fr)_auto] gap-6 items-start">
            <div>
                <p class="mt-0 mb-3 text-base min-[701px]:text-lg"><%= t('home.intro.p1') %></p>
                <p class="mt-0 mb-5 text-base min-[701px]:text-lg"><%= t('home.intro.p2') %></p>
                <div class="flex flex-wrap gap-3">
                    <a href="/calculator" class="wb-btn"><%= t('home.cta.calculator') %></a>
                    <a href="/search" class="wb-btn"><%= t('home.cta.search') %></a>
                </div>
            </div>
            <div class="hidden sm:block sink p-2">
                <img
                    src="/public/images/cover_playstation.webp"
                    alt="<%= t('home.image.alt.cover') %>"
                    class="cover-glow block max-w-[260px] h-auto"
                    loading="lazy"
                />
            </div>
        </div>
    </section>

    <div class="grid lg:grid-cols-2 gap-5">
        <section class="win">
            <div class="win-bar win-bar-green">
                <h2 class="win-title"><%= t('home.section.search.title') %></h2>
            </div>
            <div class="win-body grid md:grid-cols-[minmax(0,1fr)_auto] gap-5 items-start">
                <div>
                    <p class="mt-0 mb-5 text-base min-[701px]:text-lg"><%= t('home.section.search.body') %></p>
                    <a href="/search" class="wb-btn"><%= t('home.section.search.cta') %></a>
                </div>
                <div class="hidden md:block sink p-2">
                    <img
                        src="/public/images/fusion.gif"
                        alt="<%= t('home.image.alt.fusion') %>"
                        class="block max-w-[200px] h-auto"
                        loading="lazy"
                    />
                </div>
            </div>
        </section>

        <section class="win">
            <div class="win-bar win-bar-blue">
                <h2 class="win-title"><%= t('home.section.calculator.title') %></h2>
            </div>
            <div class="win-body grid md:grid-cols-[minmax(0,1fr)_auto] gap-5 items-start">
                <div>
                    <p class="mt-0 mb-2 text-base min-[701px]:text-lg"><%= t('home.section.calculator.body') %></p>
                    <p class="mt-0 mb-5 text-base min-[701px]:text-lg"><%= t('home.section.calculator.body-2') %></p>
                    <a href="/calculator" class="wb-btn"><%= t('home.section.calculator.cta') %></a>
                </div>
                <div class="hidden md:block sink p-2">
                    <img
                        src="/public/images/atem.png"
                        alt="<%= t('home.image.alt.atem') %>"
                        class="block max-w-[200px] h-auto"
                        loading="lazy"
                    />
                </div>
            </div>
        </section>
    </div>
</div>
