<div class="container mx-auto px-4 py-6">
    <div class="grid grid-cols-1 gap-6 items-start lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <section id="hand-section" class="bg-white/95 text-fm-primary rounded-lg p-6 shadow-lg">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 my-4">
                <h3 class="font-display text-2xl md:text-3xl"><%= t('calculator.hand.title') %></h3>
                <span id="hand-count" class="font-body text-sm"></span>
            </div>
            <div
                id="index-error"
                role="alert"
                class="hidden mb-4 rounded p-3 bg-red-100 text-red-800 border border-red-300 font-body text-sm"
            >
                <span><%= t('calculator.index.error') %></span>
                <button
                    type="button"
                    id="indexRetryBtn"
                    class="ml-3 px-3 py-1 bg-fm-primary text-white rounded hover:bg-fm-primary/80 font-display text-sm disabled:opacity-50"
                >
                    <%= t('calculator.btn.retry') %>
                </button>
            </div>
            <div id="hand-slots" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-3 xl:grid-cols-4 gap-3"></div>
            <div class="flex flex-wrap items-center gap-3 mt-6">
                <button
                    type="button"
                    id="addSlotBtn"
                    aria-describedby="add-slot-hint"
                    class="px-4 py-2 bg-fm-primary text-white rounded hover:bg-fm-primary/80 font-display text-sm disabled:opacity-50"
                >
                    <%= t('calculator.btn.add-slot') %>
                </button>
                <button
                    type="button"
                    id="resetBtn"
                    class="px-4 py-2 bg-rose-600 text-white rounded hover:bg-rose-500 font-display text-sm"
                >
                    <%= t('calculator.btn.reset') %>
                </button>
                <p id="add-slot-hint" role="status" class="font-body text-sm"></p>
            </div>
        </section>

        <div
            id="answer-column"
            data-has-answer="false"
            class="flex flex-col gap-6 min-w-0 data-[has-answer=true]:order-first lg:data-[has-answer=true]:order-none"
        >
            <section class="bg-white/95 text-fm-primary rounded-lg p-6 shadow-lg">
                <h4 class="font-display text-2xl md:text-3xl text-center my-4">
                    <%= t('calculator.chain.title') %>
                </h4>
                <div class="flex justify-center mb-4">
                    <button
                        type="button"
                        id="chainBtn"
                        class="px-4 py-2 bg-fm-primary text-white rounded hover:bg-fm-primary/80 font-display text-sm disabled:opacity-50"
                    >
                        <%= t('calculator.chain.btn') %>
                    </button>
                </div>
                <p id="chain-loading" class="text-center font-body hidden"></p>
                <div id="chain-output"></div>
            </section>
            <section class="bg-white/95 text-fm-primary rounded-lg p-6 shadow-lg">
                <h4 class="font-display text-2xl md:text-3xl text-center my-4">
                    <%= t('calculator.results.title') %>
                </h4>
                <div id="results-error"></div>
                <div id="results-status" role="status" aria-live="polite"></div>
                <div class="grid md:grid-cols-2 gap-4">
                    <div id="outputarealeft"></div>
                    <div id="outputarearight"></div>
                </div>
                <div id="rituals-output" class="hidden mt-4"></div>
            </section>
        </div>
    </div>
</div>
