<div class="max-w-[1380px] mx-auto px-6 pt-5 pb-10">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 mb-4">
        <h1 class="m-0 text-[26px] min-[701px]:text-[32px] leading-[1.1]"><%= t('search.section.title') %></h1>
    </div>

    <section class="win mb-5">
        <div class="win-bar win-bar-grey">
            <h2 class="win-title"><label for="cardname"><%= t('search.input.label') %></label></h2>
        </div>
        <div class="win-body grid md:grid-cols-2 gap-6 items-start">
            <div class="flex flex-col">
                <!-- Own block wrapper: the autocomplete list is absolute with no top, so its parent must not be flex. -->
                <div class="mb-4">
                    <input
                        type="text"
                        id="cardname"
                        placeholder="<%= t('search.input.placeholder') %>"
                        class="wb-input w-full"
                    />
                </div>
                <div class="flex flex-wrap gap-2" role="group">
                    <button type="button" id="search-name-btn" class="wb-btn"><%= t('search.btn.by-name') %></button>
                    <button type="button" id="search-results-btn" class="wb-btn"><%= t('search.btn.by-result') %></button>
                    <button type="button" id="reset-btn" class="wb-btn text-wb-red"><%= t('search.btn.reset') %></button>
                </div>
            </div>
            <div id="outputcard" class="w-full"></div>
        </div>
    </section>

    <section>
        <h2 class="m-0 mb-3 text-[19px]"><%= t('search.results.title') %></h2>
        <div id="search-msg" class="mb-3"></div>
        <div class="grid md:grid-cols-2 gap-5 items-start">
            <div id="output-area-left" class="win pb-1 empty:hidden [&>div]:mx-4 [&>h2+div]:mt-4"></div>
            <div id="output-area-right" class="win pb-1 empty:hidden [&>div]:mx-4 [&>h2+div]:mt-4"></div>
        </div>
    </section>
</div>
