<%
    const navLink = 'inline-flex items-center min-h-11 px-4 font-bold text-wb-ink hover:text-wb-ink raise hover:bg-wb-plate-hover aria-[current=page]:sink aria-[current=page]:text-wb-blue';
    const items = [
        { key: 'home', href: '/', label: t('nav.home') },
        { key: 'search', href: '/search', label: t('nav.search') },
        { key: 'calculator', href: '/calculator', label: t('nav.calculator') },
        { key: 'about', href: '/about', label: t('nav.about') },
    ];
%>
<header class="bg-wb-bar border-b-2 border-wb-lo shadow-[0_2px_0_var(--color-wb-hi)] font-body">
    <div class="max-w-[1380px] mx-auto px-6 py-2 flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/" class="raise inline-flex items-center min-h-11 pl-2.5 pr-3.5 py-1 mr-auto md:mr-0">
            <img src="/public/images/logo.png" alt="<%= t('nav.brand-alt') %>" class="h-8 md:h-9 w-auto" />
        </a>

        <button
            type="button"
            class="md:hidden wb-btn w-11 !px-0 flex-col gap-1"
            aria-label="<%= t('nav.toggle') %>"
            aria-expanded="false"
            aria-controls="primary-navigation"
            data-navbar-toggle
        >
            <span class="block w-5 h-0.5 bg-current"></span>
            <span class="block w-5 h-0.5 bg-current"></span>
            <span class="block w-5 h-0.5 bg-current"></span>
        </button>

        <nav
            id="primary-navigation"
            class="hidden md:flex flex-col md:flex-row md:flex-wrap md:items-center gap-1.5 w-full md:w-auto md:flex-1"
            data-navbar-collapse
        >
            <% items.forEach(function (item) { %>
            <a
                href="<%= item.href %>"
                class="<%= navLink %>"
                <% if (activeNav === item.key) { %>aria-current="page"<% } %>
            ><%= item.label %></a>
            <% }) %>
            <a
                href="http://forums.somethingawful.com/showthread.php?threadid=3783156"
                rel="noopener noreferrer"
                target="_blank"
                class="<%= navLink %>"
            ><%= t('nav.thread') %></a>
            <%- include('language-switcher', { lang, t }) %>
        </nav>
    </div>
    <div class="vent max-w-[1380px] mx-auto" aria-hidden="true"></div>
</header>
