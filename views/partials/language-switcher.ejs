<form method="post" action="/lang" class="flex items-center gap-1.5 font-body md:ml-auto" aria-label="<%= t('lang.label') %>">
    <% [{ code: 'es', label: t('lang.es') }, { code: 'en', label: t('lang.en') }].forEach(function (option) { %>
    <button
        type="submit"
        name="lang"
        value="<%= option.code %>"
        class="wb-btn !px-3 disabled:!bg-wb-well disabled:!text-wb-ink disabled:cursor-default disabled:[border-color:var(--color-wb-lo)_var(--color-wb-hi)_var(--color-wb-hi)_var(--color-wb-lo)]"
        aria-pressed="<%= lang === option.code ? 'true' : 'false' %>"
        <% if (lang === option.code) { %>disabled<% } %>
    ><%= option.label %></button>
    <% }) %>
</form>
